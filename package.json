{
  "name": "manaratak-2.0-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bootstrap": "npm install && npm run build",
    "dev": "npm run dev -w @manaratak/web",
    "dev:admin": "npm run dev -w @manaratak/admin",
    "prebuild": "npm run db:generate",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @manaratak/api",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules dist",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "db:generate": "prisma generate --schema=packages/infrastructure/prisma/schema.prisma",
    "db:push": "prisma db push --schema=packages/infrastructure/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/infrastructure/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/infrastructure/prisma/schema.prisma",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo:dry-run": "tsx scripts/seed-demo.ts --dry-run",
    "verify:local": "npm run typecheck && npm run lint && npm run build && npm run test && npm run e2e",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc -b",
    "e2e": "playwright test --config=apps/web/playwright.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.10.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}